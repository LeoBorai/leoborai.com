{
	"name": "leoborai-dotcom",
	"private": true,
	"version": "0.6.20",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
